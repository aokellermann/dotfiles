#!/bin/sh -e

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=sway

# XDG_CONFIG_HOME/XDG_CACHE_HOME are exported by .bash_profile; duplicated here
# so runsway stays self-contained when launched outside a bash login shell.
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"

set -o allexport
. "$XDG_CONFIG_HOME/user-dirs.dirs"
set +o allexport

# https://wiki.archlinux.org/title/wayland#Java
export _JAVA_AWT_WM_NONREPARENTING=1

# https://wiki.archlinux.org/title/Firefox#Wayland
export MOZ_ENABLE_WAYLAND=1

# https://wiki.archlinux.org/title/wayland#Qt
export QT_QPA_PLATFORM=wayland

# https://wiki.archlinux.org/title/Wayland#Environment_variable
export ELECTRON_OZONE_PLATFORM_HINT=wayland

# https://wiki.archlinux.org/title/Uniform_look_for_Qt_and_GTK_applications#Kvantum
export QT_STYLE_OVERRIDE=kvantum

# Flatpak: expose desktop entries and icons
export XDG_DATA_DIRS="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}:/var/lib/flatpak/exports/share:$HOME/.local/share/flatpak/exports/share"

# No SSH agent: all SSH keys are YubiKey-backed (sk) and signed via libfido2 directly.
# git signing also goes through ssh-keygen + YubiKey, never an agent.

# lock the session so that if sway crashes, there is no fallback to a unlocked, logged in terminal
exec sh -c 'sway; vlock -a'
