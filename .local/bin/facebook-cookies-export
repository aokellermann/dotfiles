#!/usr/bin/env python3
# Extract facebook.com / instagram.com cookies from the default Firefox profile
# and write them as a Playwright storage-state JSON file.
#
# Mirrors twitter-cookies-export. Reads cookies.sqlite (works while Firefox is
# running), filters to exact host matches for facebook.com/instagram.com and
# their dot-prefixed forms, emits the JSON at argv[1] (default:
# ~/.config/claude-facebook-profile/storage-state.json), chmod 600.

import configparser
import json
import os
import shutil
import sqlite3
import sys
import tempfile
from pathlib import Path

FF_DIR = Path.home() / ".mozilla" / "firefox"
TARGET_HOSTS = {
    "facebook.com", ".facebook.com",
    "instagram.com", ".instagram.com",
}
SAMESITE_MAP = {0: "None", 1: "Lax", 2: "Strict"}


def default_profile() -> Path:
    ini = configparser.ConfigParser()
    ini.read(FF_DIR / "profiles.ini")
    for section in ini.sections():
        if section.startswith("Install") and "Default" in ini[section]:
            return FF_DIR / ini[section]["Default"]
    for section in ini.sections():
        if ini[section].get("Default") == "1" and "Path" in ini[section]:
            return FF_DIR / ini[section]["Path"]
    raise SystemExit("could not find default Firefox profile in profiles.ini")


def extract(cookies_db: Path) -> list[dict]:
    with tempfile.NamedTemporaryFile(suffix=".sqlite", delete=False) as tmp:
        shutil.copy(cookies_db, tmp.name)
        snapshot = tmp.name
    try:
        con = sqlite3.connect(snapshot)
        placeholders = ",".join("?" * len(TARGET_HOSTS))
        cur = con.execute(
            f"SELECT name, value, host, path, expiry, isSecure, isHttpOnly, sameSite "
            f"FROM moz_cookies WHERE host IN ({placeholders})",
            tuple(TARGET_HOSTS),
        )
        rows = cur.fetchall()
        con.close()
    finally:
        os.unlink(snapshot)

    return [
        {
            "name": name,
            "value": value,
            "domain": host,
            "path": path,
            "expires": expiry / 1000 if expiry and expiry > 1e12 else (float(expiry) if expiry and expiry > 0 else -1),
            "httpOnly": bool(http_only),
            "secure": bool(secure),
            "sameSite": SAMESITE_MAP.get(samesite, "Lax"),
        }
        for name, value, host, path, expiry, secure, http_only, samesite in rows
    ]


def main() -> None:
    out = Path(
        sys.argv[1]
        if len(sys.argv) > 1
        else Path.home() / ".config" / "claude-facebook-profile" / "storage-state.json"
    )
    cookies = extract(default_profile() / "cookies.sqlite")
    # c_user is Facebook's user-id cookie; xs is the session secret. Both are
    # required for authenticated reads. (Instagram uses sessionid; if you only
    # want IG, drop the c_user check.)
    if not any(c["name"] == "c_user" and "facebook.com" in c["domain"] for c in cookies):
        raise SystemExit(
            "no c_user cookie for facebook.com found — log into facebook.com in Firefox first"
        )
    if not any(c["name"] == "xs" and "facebook.com" in c["domain"] for c in cookies):
        raise SystemExit(
            "no xs cookie for facebook.com found — session may be invalid; re-login"
        )
    out.parent.mkdir(parents=True, exist_ok=True)
    out.parent.chmod(0o700)
    out.write_text(json.dumps({"cookies": cookies, "origins": []}, indent=2))
    out.chmod(0o600)
    print(f"wrote {len(cookies)} cookies to {out}")


if __name__ == "__main__":
    main()
