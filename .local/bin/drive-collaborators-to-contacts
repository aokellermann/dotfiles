#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.12"
# dependencies = ["google-auth", "requests"]
# ///
"""Add everyone a Workspace user has shared Drive files with to their Google Contacts.

Reads the ACLs of every file the user owns plus every item in the shared drives
they belong to (via GAM's gam-delegation service account), keeps external human
collaborators who were granted access directly on a file (inherited shared-drive
membership is skipped), fills in names from Gmail's auto-collected "Other
contacts" where Drive only knows the address, diffs against the user's existing
contacts by email, and creates the missing ones in a contact group.

Shared-drive permissions don't record who did the sharing, so on those files
"shared by me" really means "shared by anyone on the team".

    drive-collaborators-to-contacts                # dry run: print what would be created
    drive-collaborators-to-contacts --apply        # create the contacts
    drive-collaborators-to-contacts --user x@safeai.org --group "Doc collaborators"

Drive ACLs come from GAM (`gam user … print drivefileacls`); contacts are read
and written through the People API directly with the same service account key
(~/.gam/oauth2service.json, DWD scope https://www.googleapis.com/auth/contacts)
because GAM's own contact commands misreport a scope mismatch as "People API
Service/App not enabled". "Other contacts" enrichment additionally needs the
contacts.other.readonly DWD scope and is skipped when that is missing.
"""

import argparse
import csv
import io
import logging
import os
import re
import subprocess
import sys

import requests
from google.auth.exceptions import RefreshError
from google.auth.transport.requests import AuthorizedSession
from google.oauth2 import service_account

log = logging.getLogger("drive-collaborators")
SA_KEY = os.path.expanduser("~/.gam/oauth2service.json")
PEOPLE = "https://people.googleapis.com/v1"


def people_session(user: str, *scopes: str) -> AuthorizedSession:
    creds = service_account.Credentials.from_service_account_file(SA_KEY, scopes=list(scopes), subject=user)
    return AuthorizedSession(creds)


def paged(sess: AuthorizedSession, url: str, key: str, **params) -> list[dict]:
    items: list[dict] = []
    token = None
    while True:
        r = sess.get(url, params={**params, **({"pageToken": token} if token else {})})
        r.raise_for_status()
        body = r.json()
        items += body.get(key, [])
        token = body.get("nextPageToken")
        if not token:
            return items


def gam(*args: str) -> str:
    cmd = ["gam", *args]
    log.debug("running: %s", " ".join(cmd))
    proc = subprocess.run(cmd, capture_output=True, text=True)
    if proc.returncode != 0:
        log.error("gam failed (%d): %s\n%s", proc.returncode, " ".join(cmd), proc.stderr.strip())
        sys.exit(proc.returncode)
    return proc.stdout


def gam_csv(*args: str) -> list[dict[str, str]]:
    return list(csv.DictReader(io.StringIO(gam(*args))))


def collaborators(user: str, home_domains: set[str], shared_drives: bool) -> dict[str, dict]:
    """email -> {name, files} for external humans granted access directly on a file."""
    rows = gam_csv("user", user, "print", "drivefileacls", "query", "'me' in owners", "oneitemperrow")
    if shared_drives:
        for sd in gam_csv("user", user, "print", "shareddrives"):
            log.info("scanning shared drive %r", sd["name"])
            rows += gam_csv("user", user, "print", "drivefileacls", "shareddriveid", sd["id"], "all_items", "oneitemperrow")
    found: dict[str, dict] = {}
    for row in rows:
        if row.get("permission.type") != "user" or row.get("permission.role") == "owner":
            continue
        if row.get("permission.deleted") == "True" or row.get("permission.permissionDetails.inherited") == "True":
            continue
        email = (row.get("permission.emailAddress") or "").strip().lower()
        if not email or email.split("@")[-1] in home_domains:
            continue
        entry = found.setdefault(email, {"name": "", "files": 0})
        entry["files"] += 1
        name = (row.get("permission.displayName") or "").strip()
        # Drive falls back to the local part of the address when there is no
        # Google profile; treat that as "no name".
        if name and name.lower() != email.split("@")[0].lower():
            entry["name"] = entry["name"] or name
    return found


def other_contact_names(user: str) -> dict[str, str]:
    """email -> display name from Gmail's auto-collected 'Other contacts' (best effort)."""
    sess = people_session(user, "https://www.googleapis.com/auth/contacts.other.readonly")
    try:
        people = paged(sess, f"{PEOPLE}/otherContacts", "otherContacts", readMask="names,emailAddresses", pageSize=1000)
    except (requests.HTTPError, RefreshError) as e:
        log.warning("skipping Other-contacts name lookup (%s); grant contacts.other.readonly via DWD to enable", type(e).__name__)
        return {}
    names: dict[str, str] = {}
    for p in people:
        name = next((n.get("displayName") for n in p.get("names", []) if n.get("displayName")), None)
        if name:
            for e in p.get("emailAddresses", []):
                names.setdefault(e.get("value", "").strip().lower(), name)
    return names


def existing_contact_emails(sess: AuthorizedSession) -> set[str]:
    people = paged(sess, f"{PEOPLE}/people/me/connections", "connections", personFields="emailAddresses", pageSize=1000)
    return {e["value"].strip().lower() for p in people for e in p.get("emailAddresses", []) if e.get("value")}


def contact_group(sess: AuthorizedSession, name: str) -> str:
    groups = paged(sess, f"{PEOPLE}/contactGroups", "contactGroups", pageSize=1000)
    for g in groups:
        if g.get("name") == name and g.get("groupType") == "USER_CONTACT_GROUP":
            return g["resourceName"]
    r = sess.post(f"{PEOPLE}/contactGroups", json={"contactGroup": {"name": name}})
    r.raise_for_status()
    log.info("created contact group %r", name)
    return r.json()["resourceName"]


def gmail_names(user: str, emails: list[str]) -> dict[str, str]:
    """email -> display name from the From/To headers of the user's own mailbox (best effort)."""
    sess = people_session(user, "https://www.googleapis.com/auth/gmail.modify")
    names: dict[str, str] = {}
    for email in emails:
        try:
            r = sess.get("https://gmail.googleapis.com/gmail/v1/users/me/messages",
                         params={"q": f"from:{email} OR to:{email}", "maxResults": 5})
            r.raise_for_status()
            for m in r.json().get("messages", []):
                h = sess.get(f"https://gmail.googleapis.com/gmail/v1/users/me/messages/{m['id']}",
                             params={"format": "metadata", "metadataHeaders": ["From", "To", "Cc"]}).json()
                for hdr in h.get("payload", {}).get("headers", []):
                    for addr in hdr["value"].split(","):
                        name, _, rest = addr.rpartition("<")
                        if rest.strip().rstrip(">").lower() == email and name.strip().strip('"'):
                            names[email] = name.strip().strip('"')
                if email in names:
                    break
        except (requests.HTTPError, RefreshError) as e:
            log.warning("skipping Gmail name lookup (%s); grant gmail.readonly/gmail.modify via DWD to enable", type(e).__name__)
            return names
    return names


def clean_name(name: str) -> str:
    name = re.sub(r"\s*\([^)]*\)", "", name).strip()          # "Ashley Walker (Omnicom)"
    if "," in name:                                              # "Garrahan, Andrew"
        last, first = (x.strip() for x in name.split(",", 1))
        name = f"{first} {last}"
    return name


def split_name(name: str) -> tuple[str, str]:
    parts = clean_name(name).split()
    if len(parts) == 1:
        return parts[0], ""
    return " ".join(parts[:-1]), parts[-1]


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--user", default="antony@safeai.org")
    ap.add_argument("--group", default="Doc collaborators", help="contact group (label) to file new contacts under")
    ap.add_argument("--home-domain", action="append", default=None, help="domain(s) to treat as internal (default: the user's)")
    ap.add_argument("--apply", action="store_true", help="create contacts (default is a dry run)")
    ap.add_argument("--list", action="store_true", help="only list collaborators; skip the contacts read/diff")
    ap.add_argument("--no-shared-drives", action="store_true", help="only scan files the user owns in My Drive")
    ap.add_argument("-v", "--verbose", action="store_true")
    args = ap.parse_args()
    logging.basicConfig(level=logging.DEBUG if args.verbose else logging.INFO, format="%(levelname)s %(message)s")

    home = set(args.home_domain or [args.user.split("@")[1]])
    log.info("reading Drive ACLs for files owned by %s", args.user)
    people = collaborators(args.user, home, not args.no_shared_drives)
    log.info("%d external collaborators", len(people))

    if args.list:
        for email, p in sorted(people.items()):
            print(f"  {email:45} {p['name'] or '(no name)':30} {p['files']} file(s)")
        return

    log.info("reading existing contacts")
    for email, name in other_contact_names(args.user).items():
        if email in people and not people[email]["name"]:
            people[email]["name"] = name
    nameless = [e for e, p in sorted(people.items()) if not p["name"]]
    if nameless:
        log.info("looking up %d names in Gmail headers", len(nameless))
        for email, name in gmail_names(args.user, nameless).items():
            people[email]["name"] = name
    sess = people_session(args.user, "https://www.googleapis.com/auth/contacts")
    have = existing_contact_emails(sess)
    missing = {e: p for e, p in people.items() if e not in have}
    log.info("%d already in contacts, %d to create", len(people) - len(missing), len(missing))

    for email, p in sorted(missing.items()):
        print(f"  {email:45} {clean_name(p['name']) or '(no name)':30} {p['files']} file(s)")
    if not missing:
        return
    if not args.apply:
        log.info("dry run; re-run with --apply to create these contacts")
        return

    group = contact_group(sess, args.group)
    for email, p in sorted(missing.items()):
        body: dict = {
            "emailAddresses": [{"value": email, "type": "work"}],
            "memberships": [{"contactGroupMembership": {"contactGroupResourceName": group}}],
            "biographies": [{"value": "Added by drive-collaborators-to-contacts (shared Drive file)"}],
        }
        if p["name"]:
            given, family = split_name(p["name"])
            body["names"] = [{"givenName": given, **({"familyName": family} if family else {})}]
        r = sess.post(f"{PEOPLE}/people:createContact", json=body)
        if r.ok:
            log.info("created %s (%s)", email, r.json()["resourceName"])
        else:
            log.error("failed %s: %s %s", email, r.status_code, r.text[:200])


if __name__ == "__main__":
    main()
