[init]
	defaultBranch = master
[user]
	email = antony@aokellermann.dev
	name = Antony Kellermann
	signingkey = ~/.ssh/git_signing_touch
[push]
	autoSetupRemote = true
[core]
	editor = nvim
[commit]
	gpgSign = false
[tag]
	gpgSign = false
[advice]
	addIgnoredFile = false
[gpg]
	format = ssh
[pull]
	rebase = false
[fetch]
	prune = true
	pruneTag = true
[branch]
	sort = -committerdate
[column]
	ui = auto
[checkout]
	workers = 0
[diff]
    tool = kitty
    guitool = kitty.gui
[difftool]
    prompt = false
    trustExitCode = true
[difftool "kitty"]
    cmd = kitten diff $LOCAL $REMOTE
[difftool "kitty.gui"]
    cmd = kitten diff $LOCAL $REMOTE
[gpg "ssh"]
	allowedSignersFile = /home/aokellermann/.ssh/allowed_signers
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
