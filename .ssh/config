AddKeysToAgent yes
IdentitiesOnly yes
HashKnownHosts yes
ControlMaster auto
ControlPath ~/.ssh/cm-%r@%h:%p
ControlPersist 8h

Host github github.com
	Hostname github.com
	IdentityFile ~/.ssh/github

Host aur aur.archlinux.org
	Hostname aur.archlinux.org
	User aur
	IdentityFile ~/.ssh/aur

Host cais 0.tcp.au.ngrok.io
	Hostname compute.safe.ai
