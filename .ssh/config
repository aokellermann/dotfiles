	IdentityFile ~/.ssh/cais.pub

Host uiuc
	Hostname cc-login.campuscluster.illinois.edu
	User antonyk

Host hf huggingface.com
	Hostname hf.co
	User git
	IdentityFile ~/.ssh/hf.pub

