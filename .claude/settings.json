{
  "cleanupPeriodDays": 30,
  "env": {
    "ENABLE_LSP_TOOL": "1",
    "DISABLE_AUTOUPDATER": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(docker:*)",
      "Bash(python:*)",
      "Bash(uv:*)",
      "Bash(git:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Read",
      "Write",
      "Edit"
    ],
    "deny": [
      "Read(/home/aokellermann/docs)",
      "Bash(sudo:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-fable-5",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "dcg"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "docent@transluce-plugins": false,
    "frontend-design@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "notion@claude-plugins-official": true,
    "asana@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "transluce-plugins": {
      "source": {
        "source": "github",
        "repo": "TransluceAI/claude-code-plugins"
      }
    }
  },
  "effortLevel": "medium",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "preferredNotifChannel": "notifications_disabled",
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
